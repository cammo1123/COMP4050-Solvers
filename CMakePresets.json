{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake"
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "core",
      "inherits": "base",
      "displayName": "Debug (C++ only, no Node addon)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "COMP4050_BUILD_ADDON": "OFF"
      }
    },
    {
      "name": "core-release",
      "inherits": "base",
      "displayName": "Release (C++ only, no Node addon)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "COMP4050_BUILD_ADDON": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "core",
      "configurePreset": "core"
    },
    {
      "name": "core-release",
      "configurePreset": "core-release"
    }
  ]
}
