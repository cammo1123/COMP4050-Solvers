include "../types.fbs";

namespace fbs;

attribute "optional";

table SolveRequest {
  boxes: [BoxType];
  items: [ItemType];
  options: SolveOptions (optional);
}

table SolveOptions {
  max_boxes: uint = null;
  allow_rotation: bool = true;
  timeout_ms: uint = null;
  strategy: byte = null;
  balance_weight: bool = null;
  all_permutations: bool = null;
  single_box: bool = null;
}

table ItemPlacement {
  item_code: string;
  item_reference: string;
  x: uint;
  y: uint;
  z: uint;
  width: uint;
  length: uint;
  depth: uint;
}

table BoxResult {
  box_reference: string;
  placements: [ItemPlacement];
  total_weight: float = null;
  utilization: float = null;
}

table SolveResponse {
  results: [BoxResult];
  failed: [ItemType];
}

root_type SolveRequest;
