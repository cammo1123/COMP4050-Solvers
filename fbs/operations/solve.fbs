include "../types.fbs";

namespace fbs;

attribute "optional";

table SolveRequest {
  boxes: [BoxType] (required);
  items: [ItemType] (required);
  options: SolveOptions (optional);
}

enum SolveAlgorithm : byte {
	Greedy = 0,
	ExtremePoint = 1,
	ShitStack = 2,
}

table SolveOptions {
  max_boxes: uint = null;
  allow_rotation: bool = true;
  timeout_ms: uint = null;
  algorithm: SolveAlgorithm = null;
}

table ItemPlacement {
item_code: string;
  item_reference: string;
  x: uint;
  y: uint;
  z: uint;
  width: uint;
  length: uint;
  depth: uint;
}

table BoxResult {
  box_reference: string;
  placements: [ItemPlacement];
}

table SolveResponse {
  results: [BoxResult];
  failed: [ItemType];
}

root_type SolveRequest;
