include "../types.fbs";

namespace fbs;

attribute "optional";

enum SolveStrategy : byte {
  Default = 0,
  Utilization = 1
}

table SolveRequest {
  boxes: [BoxType] (required);
  items: [ItemType] (required);
  options: SolveOptions (optional);
}

table SolveOptions {
  max_boxes: uint = null;
  allow_rotation: bool = true;
  timeout_ms: uint = null;
  strategy: SolveStrategy = null;
  balance_weight: bool = null;
  all_permutations: bool = null;
  single_box: bool = null;
  strict_item_order: bool = null;
  best_subset: bool = null;
}

table ItemPlacement {
  item_code: string;
  item_reference: string;
  x: uint;
  y: uint;
  z: uint;
  width: uint;
  length: uint;
  depth: uint;
}

table BoxResult {
  box_reference: string;
  placements: [ItemPlacement];
  total_weight: float = null;
  utilization: float = null;
  outer_width: uint = null;
  outer_length: uint = null;
  outer_depth: uint = null;
}

table SolveResponse {
  results: [BoxResult];
  failed: [ItemType];
}

root_type SolveRequest;
