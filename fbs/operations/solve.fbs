include "../types.fbs";

namespace fbs;

attribute "optional";
attribute "algorithm_specific_options";

table ExtremePointOptions {}

table StackBasedOptions {}

table HeightmapSolverOptions {
  max_boxes: uint = null;
  allow_rotation: bool = true;
  min_support : double = null;
  cell_size : uint = null;  // ignored: the heightmap is exact in mm
  restarts : uint = null;
  seed : uint = null;
  strict_unsupported : bool = null;
  combos : ubyte = null;            // 0 off, 1 on, 2 both (default: solve with and without, keep the better)
  combo_threshold : double = null;  // min filled share of a glued pair's bounding box (default 0.90)
  heavy_on_bottom : bool = null;    // never rest an item on a lighter one (default true)
}


table PHPSolverOptions {
  balance_weight: bool = null;
  all_permutations: bool = null;
  single_box: bool = null;
  strict_item_order: bool = null;
  best_subset: bool = null;
  max_boxes: uint = null;
  allow_rotation: bool = true;
}

union SolveStrategyOptions {
  ExtremePointOptions,
  StackBasedOptions,
  PHPSolverOptions,
  HeightmapSolverOptions
}

enum SolveAlgorithm : byte {
	ExtremePoint = 0,
	StackBased = 1,
  PHPSolver = 2,
  HeightmapSolver = 3,
}

table SolveRequest {
  boxes: [BoxType] (required);
  items: [ItemType] (required);
  algorithm: SolveAlgorithm = ExtremePoint;
  options: SolveOptions (optional);
}

table SolveOptions {
  timeout_ms: uint = null;
  algo_options: SolveStrategyOptions (algorithm_specific_options);
}

table ItemPlacement {
  x: uint;
  y: uint;
  z: uint;
  item: ItemType;
}

table BoxResult {
  box_reference: string;
  width: uint;
  length: uint;
  depth: uint;
  placements: [ItemPlacement];
  total_weight: float = null;
  utilization: float = null;
  outer_width: uint = null;
  outer_length: uint = null;
  outer_depth: uint = null;
}

table SolveResponse {
  results: [BoxResult];
  failed: [ItemType];
  algorithm_us: uint = 0;
  server_us: uint = 0;
}

root_type SolveRequest;
