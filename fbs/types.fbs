namespace fbs;

attribute "optional";

table BoxType {
  reference: string;
  width: float;
  length: float;
  depth: float;

  max_weight: float = null;
  box_weight: float = null;
  active: bool = null;
  maximum_boxes: int = null;
}

table ItemType {
  item_code: string;
  item_reference: string;
  width: int;
  length: int;
  depth: int;
  weight: float;

  box_group: string (optional);
}
