namespace fbs;

attribute "optional";

table BoxType {
  reference: string (required);
  width: uint;
  length: uint;
  depth: uint;

  max_weight: float = null;
  box_weight: float = null;
  active: bool = null;
  maximum_boxes: uint = null;
}

table ItemType {
  item_code: string (required);
  item_reference: string (required);
  width: uint;
  length: uint;
  depth: uint;
  weight: float;

  box_group: string (optional);
}
