namespace fbs;

attribute "optional";

table BoxType {
  reference: string;
  width: uint;
  length: uint;
  depth: uint;

  max_weight: float = null;
  box_weight: float = null;
  active: bool = null;
  maximum_boxes: uint = null;
}

table ItemType {
  item_code: string;
  item_reference: string;
  width: uint;
  length: uint;
  depth: uint;
  weight: float;

  box_group: string (optional);
  // 0 = never, 1 = keep flat (Y axis fixed), 2 = best fit.
  rotation_policy: byte = null;
}
