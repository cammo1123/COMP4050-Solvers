---
# Start from no checks so adding clang-tidy does not silently enable a large,
# noisy policy. Generated FlatBuffers headers are excluded below.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  performance-*,
  portability-*,
  modernize-use-emplace,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  -bugprone-exception-escape,
  -bugprone-throwing-static-initialization,
  readability-container-size-empty,
  readability-redundant-string-cstr,
  readability-suspicious-call-argument,
  -bugprone-easily-swappable-parameters,
  -portability-avoid-pragma-once,
  -bugprone-macro-parentheses,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err58-cpp,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -performance-noexcept-move-constructor,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-uppercase-literal-suffix

WarningsAsErrors: ''
# No lookahead: clang-tidy's regex engine does not support (?!...), and an
# invalid pattern matched no header at all. src/gen is excluded below instead.
HeaderFilterRegex: '[/\\]src[/\\]'
ExcludeHeaderFilterRegex: '[/\\]src[/\\]gen[/\\]'
FormatStyle: file
SystemHeaders: false

CheckOptions:
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: true
