{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake:configure:core",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-DCOMP4050_BUILD_ADDON=OFF",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-G",
        "Ninja",
        "-DCMAKE_MAKE_PROGRAM=ninja",
        "-DCMAKE_CXX_COMPILER=clang-cl"
      ],
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "build:core",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": [
        "cmake:configure:core"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "cmake:configure:addon",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-DCOMP4050_BUILD_ADDON=ON",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-G",
        "Ninja",
        "-DCMAKE_MAKE_PROGRAM=ninja",
        "-DCMAKE_CXX_COMPILER=clang-cl"
      ],
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "cmake:build:addon",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "hide": true,
      "dependsOn": [
        "cmake:configure:addon"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "build:node",
      "type": "process",
      "command": "${env:ComSpec}",
      "args": [
        "/d",
        "/c",
        "if not exist node\\build\\Release mkdir node\\build\\Release && copy /y build\\addon.node node\\build\\Release\\addon.node"
      ],
      "group": "build",
      "problemMatcher": [],
      "dependsOn": [
        "cmake:configure:addon",
        "cmake:build:addon"
      ],
      "dependsOrder": "sequence"
    }
  ]
}
