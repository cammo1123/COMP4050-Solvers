# Tells clangd where to find the compilation database generated by
# `pnpm compile-commands` (see scripts/generate-compile-commands.mjs).
CompileFlags:
  CompilationDatabase: build
  # node-addon-api requires C++17, but the gyp-generated command does not
  # specify a language standard (and clangd would otherwise default to C++14).
  Add:
    - -std=c++17
